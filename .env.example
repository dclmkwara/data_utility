APP_NAME=DCLM Field Utility
# Use production in FastAPI Cloud and set UTILITY_SESSION_KEY as a cloud secret.
APP_ENV=development
HOST=127.0.0.1
PORT=5098

BACKEND_API_URL=https://dclm-admin-app.fastapicloud.dev
BACKEND_LOCAL_API_URL=http://127.0.0.1:8000
API_TIMEOUT_SECONDS=15

# Set a long random value for production. Development uses the ignored .sesskey file.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
UTILITY_SESSION_KEY=
